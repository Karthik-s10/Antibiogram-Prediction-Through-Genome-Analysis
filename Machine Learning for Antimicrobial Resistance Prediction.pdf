      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Machine Learning for Antimicrobial Resistance Prediction: Current Practice, Limitations, and Clinical Perspective</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/cmr.00179-21</rdf:li>
        </rdf:Alt>
